# Copy this file to .env in the backend folder and fill the values before running the server.
# Example values are placeholders — do NOT commit real secrets.

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/mercadona?retryWrites=true&w=majority

# Server
PORT=5000
NODE_ENV=development

# OpenAI (if using AI endpoints)
OPENAI_API_KEY=your_openai_api_key_here

# JWT secret used by auth routes
JWT_SECRET=your_jwt_secret_here

# Optional: external API keys or service URLs
# SENTRY_DSN=...
# REDIS_URL=...
# Configuración del Servidor
PORT=5000
NODE_ENV=development

# Base de Datos
MONGODB_URI=mongodb://localhost:27017/mercadona_supermercado

# JWT
JWT_SECRET=tu_clave_secreta_muy_segura_aqui
JWT_EXPIRE=7d

# OpenAI API
OPENAI_API_KEY=tu_api_key_de_openai

# Gemini API (Opcional)
GEMINI_API_KEY=tu_api_key_de_gemini

# Configuración de Negocio
IVA_PERCENTAGE=21
LOW_STOCK_THRESHOLD=10
